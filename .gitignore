# The global excludes file on the development machine ignores every dotfile
# and package-lock.json. These rules outrank it, so the files the project
# tracks are added by a plain `git add <path>` on any machine.
!.gitignore
!.gitattributes
!.editorconfig
!.npmrc
!.vscodeignore
!.vscode-test.mjs
!package-lock.json
!.github/
.github/*
!.github/workflows/
!.github/dependabot.yml
!.github/ISSUE_TEMPLATE/
!.github/PULL_REQUEST_TEMPLATE.md
!.vscode/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Local working material: personal paths, screenshots, AI tooling and notes.
# Never committed, packed or published.
.claude/
.support/
.archive/
.backups/
.tmp/
task.bat
*.code-workspace
*.lnk
*.ai

# Built output, installed dependencies, packages and the VS Code builds the
# integration tests download
out/
_site/
dist/
media/dist/
node_modules/
coverage/
.vscode-test/
*.tgz
*.vsix
